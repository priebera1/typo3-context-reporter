{
    "name": "priebera/typo3-context-reporter",
    "description": "Object-aware support reports for the TYPO3 backend: editors report a problem where it happens, and the page, record, file, site, language, workspace and system context is attached automatically.",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "homepage": "https://typo3.priebera.sk/context-reporter",
    "keywords": [
        "typo3",
        "typo3-extension",
        "support",
        "bug-report",
        "issue-report",
        "feedback",
        "screenshot",
        "backend",
        "webhook",
        "editor-workflow"
    ],
    "authors": [
        {
            "name": "Patrik Priebera",
            "email": "patrik@priebera.sk",
            "role": "Developer",
            "homepage": "https://www.priebera.sk/"
        }
    ],
    "support": {
        "issues": "https://github.com/priebera1/typo3-context-reporter/issues",
        "source": "https://github.com/priebera1/typo3-context-reporter",
        "email": "support@priebera.sk"
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0",
        "ext-json": "*",
        "doctrine/dbal": "^4.2",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^3.0",
        "symfony/console": "^7.2",
        "symfony/dependency-injection": "^7.2",
        "symfony/mailer": "^7.2",
        "symfony/mime": "^7.2",
        "typo3/cms-backend": "^13.4 || ^14.3",
        "typo3/cms-core": "^13.4 || ^14.3",
        "typo3/cms-filelist": "^13.4 || ^14.3"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "typo3/cms-workspaces": "^13.4 || ^14.3",
        "typo3/testing-framework": "^9.6"
    },
    "suggest": {
        "typo3/cms-workspaces": "Reports include the title of the backend user's current workspace."
    },
    "autoload": {
        "psr-4": {
            "Priebera\\ContextReporter\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Priebera\\ContextReporter\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        },
        "bin-dir": ".Build/bin",
        "sort-packages": true,
        "vendor-dir": ".Build/vendor"
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "context_reporter",
            "version": "0.1.0",
            "web-dir": ".Build/public",
            "Package": {
                "providesPackages": {}
            }
        }
    },
    "scripts": {
        "ci:php:cs": "php-cs-fixer fix --config=Build/php-cs-fixer.php --dry-run --diff",
        "ci:php:stan": "phpstan analyse -c Build/phpstan.neon --no-progress",
        "ci:tests:unit": "phpunit -c phpunit.unit.xml",
        "ci:tests:functional": "phpunit -c phpunit.xml",
        "fix:php:cs": "php-cs-fixer fix --config=Build/php-cs-fixer.php"
    }
}
