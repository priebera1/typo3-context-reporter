                <target state="translated">Der Hub hat den Screenshot nicht angenommen, weil er zu groß ist.</target>
            </trans-unit>
            <trans-unit id="context_reporter.result.hubScreenshot.reason.unsupported" resname="context_reporter.result.hubScreenshot.reason.unsupported">
