<?xml version="1.0" encoding="UTF-8"?>
<xliff version="1.2" xmlns="urn:oasis:names:tc:xliff:document:1.2">
    <file source-language="en" target-language="de" datatype="plaintext" original="EXT:context_reporter/Resources/Private/Language/locallang_js.xlf" date="2026-09-16T12:00:00Z" product-name="context_reporter">
        <header/>
        <body>
            <trans-unit id="context_reporter.dialog.title" resname="context_reporter.dialog.title">
                <source>Report a problem</source>
                <target state="translated">Problem melden</target>
            </trans-unit>
            <trans-unit id="context_reporter.dialog.loading" resname="context_reporter.dialog.loading">
                <source>Collecting the TYPO3 context…</source>
                <target state="translated">TYPO3-Kontext wird ermittelt …</target>
            </trans-unit>
            <trans-unit id="context_reporter.dialog.failed" resname="context_reporter.dialog.failed">
                <source>The report dialog could not be prepared</source>
                <target state="translated">Der Meldedialog konnte nicht vorbereitet werden</target>
            </trans-unit>
            <trans-unit id="context_reporter.subject.heading" resname="context_reporter.subject.heading">
                <source>Detected context</source>
                <target state="translated">Erkannter Kontext</target>
            </trans-unit>
            <trans-unit id="context_reporter.subject.explanation" resname="context_reporter.subject.explanation">
                <source>The TYPO3 context and technical details are attached automatically.</source>
                <target state="translated">Der TYPO3-Kontext und technische Details werden automatisch angehängt.</target>
            </trans-unit>
            <trans-unit id="context_reporter.form.title" resname="context_reporter.form.title">
                <source>Short title</source>
                <target state="translated">Kurzer Titel</target>
            </trans-unit>
            <trans-unit id="context_reporter.form.title.placeholder" resname="context_reporter.form.title.placeholder">
                <source>e.g. The image selector shows no files</source>
                <target state="translated">z. B. Die Bildauswahl zeigt keine Dateien an</target>
            </trans-unit>
            <trans-unit id="context_reporter.form.title.required" resname="context_reporter.form.title.required">
                <source>Please enter a short title.</source>
                <target state="translated">Bitte geben Sie einen kurzen Titel ein.</target>
            </trans-unit>
            <trans-unit id="context_reporter.form.description" resname="context_reporter.form.description">
                <source>What happened?</source>
                <target state="translated">Was ist passiert?</target>
            </trans-unit>
            <trans-unit id="context_reporter.form.description.placeholder" resname="context_reporter.form.description.placeholder">
                <source>What did you try to do, what did you expect, and what happened instead?</source>
                <target state="translated">Was wollten Sie tun, was haben Sie erwartet und was ist stattdessen passiert?</target>
            </trans-unit>
            <trans-unit id="context_reporter.form.description.hint" resname="context_reporter.form.description.hint">
                <source>Optional, but helpful.</source>
                <target state="translated">Optional, aber hilfreich.</target>
            </trans-unit>
            <trans-unit id="context_reporter.form.description.counter" resname="context_reporter.form.description.counter">
                <source>%s / %s</source>
                <target state="translated">%s / %s</target>
            </trans-unit>
            <trans-unit id="context_reporter.screenshot.legend" resname="context_reporter.screenshot.legend">
                <source>Screenshot (optional)</source>
                <target state="translated">Screenshot (optional)</target>
            </trans-unit>
            <trans-unit id="context_reporter.screenshot.privacy" resname="context_reporter.screenshot.privacy">
                <source>Screenshots are created and edited in your browser. Nothing is sent before you submit the report. Redact confidential information first.</source>
                <target state="translated">Screenshots werden in Ihrem Browser erstellt und bearbeitet. Vor dem Absenden wird nichts übertragen. Schwärzen Sie vertrauliche Informationen vorher.</target>
            </trans-unit>
            <trans-unit id="context_reporter.screenshot.capture" resname="context_reporter.screenshot.capture">
                <source>Capture screen</source>
                <target state="translated">Bildschirm aufnehmen</target>
            </trans-unit>
            <trans-unit id="context_reporter.screenshot.upload" resname="context_reporter.screenshot.upload">
                <source>Upload image</source>
                <target state="translated">Bild hochladen</target>
            </trans-unit>
            <trans-unit id="context_reporter.screenshot.hint" resname="context_reporter.screenshot.hint">
                <source>Capture this browser tab, upload an image, or paste one with Ctrl+V / Cmd+V.</source>
                <target state="translated">Nehmen Sie diesen Browser-Tab auf, laden Sie ein Bild hoch oder fügen Sie eines mit Strg+V / Cmd+V ein.</target>
            </trans-unit>
            <trans-unit id="context_reporter.screenshot.hintNoCapture" resname="context_reporter.screenshot.hintNoCapture">
                <source>Upload an image or paste one with Ctrl+V / Cmd+V.</source>
                <target state="translated">Laden Sie ein Bild hoch oder fügen Sie eines mit Strg+V / Cmd+V ein.</target>
            </trans-unit>
            <trans-unit id="context_reporter.screenshot.remove" resname="context_reporter.screenshot.remove">
                <source>Remove screenshot</source>
                <target state="translated">Screenshot entfernen</target>
            </trans-unit>
            <trans-unit id="context_reporter.screenshot.status" resname="context_reporter.screenshot.status">
                <source>%s px · annotations: %s</source>
                <target state="translated">%s px · Markierungen: %s</target>
            </trans-unit>
            <trans-unit id="context_reporter.screenshot.error.captureFailed" resname="context_reporter.screenshot.error.captureFailed">
                <source>The screen could not be captured.</source>
                <target state="translated">Der Bildschirm konnte nicht aufgenommen werden.</target>
            </trans-unit>
            <trans-unit id="context_reporter.screenshot.error.unsupportedFile" resname="context_reporter.screenshot.error.unsupportedFile">
                <source>This file is not a supported image. Please use PNG, JPEG, WebP or GIF.</source>
                <target state="translated">Diese Datei ist kein unterstütztes Bild. Bitte verwenden Sie PNG, JPEG, WebP oder GIF.</target>
            </trans-unit>
            <trans-unit id="context_reporter.screenshot.error.fileTooLarge" resname="context_reporter.screenshot.error.fileTooLarge">
                <source>The image is too large.</source>
                <target state="translated">Das Bild ist zu groß.</target>
            </trans-unit>
            <trans-unit id="context_reporter.editor.toolbar" resname="context_reporter.editor.toolbar">
                <source>Annotation tools</source>
                <target state="translated">Markierungswerkzeuge</target>
            </trans-unit>
            <trans-unit id="context_reporter.editor.colors" resname="context_reporter.editor.colors">
                <source>Colors</source>
                <target state="translated">Farben</target>
            </trans-unit>
            <trans-unit id="context_reporter.editor.tool.select" resname="context_reporter.editor.tool.select">
                <source>Select</source>
                <target state="translated">Auswählen</target>
            </trans-unit>
            <trans-unit id="context_reporter.editor.tool.rectangle" resname="context_reporter.editor.tool.rectangle">
                <source>Rectangle</source>
                <target state="translated">Rechteck</target>
            </trans-unit>
            <trans-unit id="context_reporter.editor.tool.arrow" resname="context_reporter.editor.tool.arrow">
                <source>Arrow</source>
                <target state="translated">Pfeil</target>
            </trans-unit>
            <trans-unit id="context_reporter.editor.tool.draw" resname="context_reporter.editor.tool.draw">
                <source>Draw</source>
                <target state="translated">Zeichnen</target>
            </trans-unit>
            <trans-unit id="context_reporter.editor.tool.text" resname="context_reporter.editor.tool.text">
                <source>Text</source>
                <target state="translated">Text</target>
            </trans-unit>
            <trans-unit id="context_reporter.editor.tool.redact" resname="context_reporter.editor.tool.redact">
                <source>Redact</source>
                <target state="translated">Schwärzen</target>
            </trans-unit>
            <trans-unit id="context_reporter.editor.color.red" resname="context_reporter.editor.color.red">
                <source>Red</source>
                <target state="translated">Rot</target>
            </trans-unit>
            <trans-unit id="context_reporter.editor.color.orange" resname="context_reporter.editor.color.orange">
                <source>Orange</source>
                <target state="translated">Orange</target>
            </trans-unit>
            <trans-unit id="context_reporter.editor.color.green" resname="context_reporter.editor.color.green">
                <source>Green</source>
                <target state="translated">Grün</target>
            </trans-unit>
            <trans-unit id="context_reporter.editor.color.blue" resname="context_reporter.editor.color.blue">
                <source>Blue</source>
                <target state="translated">Blau</target>
            </trans-unit>
            <trans-unit id="context_reporter.editor.color.black" resname="context_reporter.editor.color.black">
                <source>Black</source>
                <target state="translated">Schwarz</target>
            </trans-unit>
            <trans-unit id="context_reporter.editor.undo" resname="context_reporter.editor.undo">
                <source>Undo</source>
                <target state="translated">Rückgängig</target>
            </trans-unit>
            <trans-unit id="context_reporter.editor.redo" resname="context_reporter.editor.redo">
                <source>Redo</source>
                <target state="translated">Wiederholen</target>
            </trans-unit>
            <trans-unit id="context_reporter.editor.deleteSelection" resname="context_reporter.editor.deleteSelection">
                <source>Delete selected annotation</source>
                <target state="translated">Ausgewählte Markierung löschen</target>
            </trans-unit>
            <trans-unit id="context_reporter.editor.canvas" resname="context_reporter.editor.canvas">
                <source>Screenshot with annotations</source>
                <target state="translated">Screenshot mit Markierungen</target>
            </trans-unit>
            <trans-unit id="context_reporter.editor.textInput" resname="context_reporter.editor.textInput">
                <source>Type a note and press Enter</source>
                <target state="translated">Notiz eingeben und Enter drücken</target>
            </trans-unit>
            <trans-unit id="context_reporter.editor.editText" resname="context_reporter.editor.editText">
                <source>Edit the note and press Enter</source>
                <target state="translated">Notiz bearbeiten und Enter drücken</target>
            </trans-unit>
            <trans-unit id="context_reporter.editor.hint" resname="context_reporter.editor.hint">
                <source>Drag to draw. Click an annotation to select it, then drag to move it or press Delete to remove it. Double-click a note to edit it. Redact paints an opaque black box into the image that is sent.</source>
                <target state="translated">Zum Zeichnen ziehen. Eine Markierung anklicken, um sie auszuwählen; dann ziehen, um sie zu verschieben, oder Entf drücken, um sie zu entfernen. Eine Notiz doppelt anklicken, um sie zu bearbeiten. Schwärzen übermalt den Bereich im gesendeten Bild mit einem deckenden schwarzen Kasten.</target>
            </trans-unit>
            <trans-unit id="context_reporter.technical.summary" resname="context_reporter.technical.summary">
                <source>Review the technical data that will be sent</source>
                <target state="translated">Technische Daten prüfen, die gesendet werden</target>
            </trans-unit>
            <trans-unit id="context_reporter.technical.explanation" resname="context_reporter.technical.explanation">
                <source>This is exactly what will be stored and sent. The report ID, the time and the image data are added when you submit.</source>
                <target state="translated">Genau diese Daten werden gespeichert und gesendet. Meldungs-ID, Zeitpunkt und Bilddaten werden beim Absenden ergänzt.</target>
            </trans-unit>
            <trans-unit id="context_reporter.technical.assignedOnSubmit" resname="context_reporter.technical.assignedOnSubmit">
                <source>(assigned on submit)</source>
                <target state="translated">(wird beim Absenden vergeben)</target>
            </trans-unit>
            <trans-unit id="context_reporter.technical.screenshotContent" resname="context_reporter.technical.screenshotContent">
                <source>(the edited image, added on submit)</source>
                <target state="translated">(das bearbeitete Bild, wird beim Absenden ergänzt)</target>
            </trans-unit>
            <trans-unit id="context_reporter.destinations.send" resname="context_reporter.destinations.send">
                <source>The report will be saved in TYPO3 and sent via: %s.</source>
                <target state="translated">Die Meldung wird in TYPO3 gespeichert und gesendet per: %s.</target>
            </trans-unit>
            <trans-unit id="context_reporter.destinations.localOnly" resname="context_reporter.destinations.localOnly">
                <source>The report will be saved in the TYPO3 report history.</source>
                <target state="translated">Die Meldung wird im TYPO3-Meldungsverlauf gespeichert.</target>
            </trans-unit>
            <trans-unit id="context_reporter.button.cancel" resname="context_reporter.button.cancel">
                <source>Cancel</source>
                <target state="translated">Abbrechen</target>
            </trans-unit>
            <trans-unit id="context_reporter.button.download" resname="context_reporter.button.download">
                <source>Save and download</source>
                <target state="translated">Speichern und herunterladen</target>
            </trans-unit>
            <trans-unit id="context_reporter.button.send" resname="context_reporter.button.send">
                <source>Send report</source>
                <target state="translated">Meldung senden</target>
            </trans-unit>
            <trans-unit id="context_reporter.button.save" resname="context_reporter.button.save">
                <source>Save report</source>
                <target state="translated">Meldung speichern</target>
            </trans-unit>
            <trans-unit id="context_reporter.button.close" resname="context_reporter.button.close">
                <source>Close</source>
                <target state="translated">Schließen</target>
            </trans-unit>
            <trans-unit id="context_reporter.button.retry" resname="context_reporter.button.retry">
                <source>Try again</source>
                <target state="translated">Erneut versuchen</target>
            </trans-unit>
            <trans-unit id="context_reporter.result.saved" resname="context_reporter.result.saved">
                <source>Report %s was saved.</source>
                <target state="translated">Meldung %s wurde gespeichert.</target>
            </trans-unit>
            <trans-unit id="context_reporter.result.delivered" resname="context_reporter.result.delivered">
                <source>Report %s was sent.</source>
                <target state="translated">Meldung %s wurde gesendet.</target>
            </trans-unit>
            <trans-unit id="context_reporter.result.deliveryFailed" resname="context_reporter.result.deliveryFailed">
                <source>Report %s was saved, but not every delivery succeeded.</source>
                <target state="translated">Meldung %s wurde gespeichert, aber nicht jede Zustellung war erfolgreich.</target>
            </trans-unit>
            <trans-unit id="context_reporter.result.downloaded" resname="context_reporter.result.downloaded">
                <source>Report %s was saved and downloaded.</source>
                <target state="translated">Meldung %s wurde gespeichert und heruntergeladen.</target>
            </trans-unit>
            <trans-unit id="context_reporter.result.deliverySucceeded" resname="context_reporter.result.deliverySucceeded">
                <source>Sent via %s</source>
                <target state="translated">Gesendet per %s</target>
            </trans-unit>
            <trans-unit id="context_reporter.result.deliveryFailedTo" resname="context_reporter.result.deliveryFailedTo">
                <source>Could not be sent via %s</source>
                <target state="translated">Konnte nicht per %s gesendet werden</target>
            </trans-unit>
            <trans-unit id="context_reporter.result.retryHint" resname="context_reporter.result.retryHint">
                <source>An administrator can retry the delivery in System › Context Reports.</source>
                <target state="translated">Administratoren können die Zustellung unter System › Kontext-Meldungen erneut auslösen.</target>
            </trans-unit>
            <trans-unit id="context_reporter.result.openReport" resname="context_reporter.result.openReport">
                <source>Open report</source>
                <target state="translated">Meldung öffnen</target>
            </trans-unit>
            <trans-unit id="context_reporter.result.copy" resname="context_reporter.result.copy">
                <source>Copy</source>
                <target state="translated">Kopieren</target>
            </trans-unit>
            <trans-unit id="context_reporter.result.copy.summary" resname="context_reporter.result.copy.summary">
                <source>Summary as text</source>
                <target state="translated">Zusammenfassung als Text</target>
            </trans-unit>
            <trans-unit id="context_reporter.result.copy.markdown" resname="context_reporter.result.copy.markdown">
                <source>Markdown</source>
                <target state="translated">Markdown</target>
            </trans-unit>
            <trans-unit id="context_reporter.result.copy.json" resname="context_reporter.result.copy.json">
                <source>JSON (without screenshot)</source>
                <target state="translated">JSON (ohne Screenshot)</target>
            </trans-unit>
            <trans-unit id="context_reporter.result.copy.link" resname="context_reporter.result.copy.link">
                <source>Link to this report</source>
                <target state="translated">Link zu dieser Meldung</target>
            </trans-unit>
            <trans-unit id="context_reporter.result.download" resname="context_reporter.result.download">
                <source>Download</source>
                <target state="translated">Herunterladen</target>
            </trans-unit>
            <trans-unit id="context_reporter.result.download.markdown" resname="context_reporter.result.download.markdown">
                <source>Markdown (.md)</source>
                <target state="translated">Markdown (.md)</target>
            </trans-unit>
            <trans-unit id="context_reporter.result.download.json" resname="context_reporter.result.download.json">
                <source>JSON (.json)</source>
                <target state="translated">JSON (.json)</target>
            </trans-unit>
            <trans-unit id="context_reporter.result.download.jsonWithScreenshot" resname="context_reporter.result.download.jsonWithScreenshot">
                <source>JSON with screenshot (.json)</source>
                <target state="translated">JSON mit Screenshot (.json)</target>
            </trans-unit>
            <trans-unit id="context_reporter.result.download.screenshot" resname="context_reporter.result.download.screenshot">
                <source>Screenshot</source>
                <target state="translated">Screenshot</target>
            </trans-unit>
            <trans-unit id="context_reporter.error.http" resname="context_reporter.error.http">
                <source>The server responded with an error (HTTP %s).</source>
                <target state="translated">Der Server hat mit einem Fehler geantwortet (HTTP %s).</target>
            </trans-unit>
            <trans-unit id="context_reporter.error.unexpected" resname="context_reporter.error.unexpected">
                <source>Something went wrong. Please try again.</source>
                <target state="translated">Etwas ist schiefgelaufen. Bitte versuchen Sie es erneut.</target>
            </trans-unit>
        </body>
