                <target state="translated">Ein erneuter Versand ist sicher: Context Reporter Hub speichert die Meldung nur einmal und zeigt dann ihre Referenz.</target>
            </trans-unit>
            <trans-unit id="context_reporter.result.openReport" resname="context_reporter.result.openReport">
