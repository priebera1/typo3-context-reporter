                <target state="translated">Screenshot verwerfen?</target>
            </trans-unit>
            <trans-unit id="context_reporter.discard.hint" resname="context_reporter.discard.hint">
                <source>Title and description are kept for 30 minutes when you close the dialog. The screenshot and its annotations are not.</source>
                <target state="translated">Titel und Beschreibung bleiben beim Schließen 30 Minuten erhalten, der Screenshot und seine Markierungen nicht.</target>
            </trans-unit>
            <trans-unit id="context_reporter.discard.keep" resname="context_reporter.discard.keep">
