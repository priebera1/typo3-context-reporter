            </trans-unit>
            <trans-unit id="context_reporter.discard.keep" resname="context_reporter.discard.keep">
                <source>Keep editing</source>
            </trans-unit>
            <trans-unit id="context_reporter.discard.confirm" resname="context_reporter.discard.confirm">
