{
  "name": "typo3-context-reporter-build",
  "private": true,
  "description": "Development tooling of the TYPO3 extension context_reporter. Not needed to run the extension.",
  "license": "GPL-2.0-or-later",
  "type": "module",
  "scripts": {
    "build:konva": "esbuild Build/JavaScript/konva-entry.mjs --bundle --format=esm --minify --target=es2022 --legal-comments=inline --outfile=Resources/Public/JavaScript/contrib/konva.js",
    "test:js": "vitest run --dir Tests/JavaScript"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "jsdom": "^27.0.0",
    "konva": "10.5.0",
    "vitest": "^3.2.4"
  }
}
