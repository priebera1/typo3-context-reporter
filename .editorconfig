root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{js,mjs,json,css,yaml,yml,xlf,html,svg,neon}]
indent_size = 2

[*.{xlf,html}]
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.rst]
indent_size = 3
